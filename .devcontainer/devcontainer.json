{
    "name": "ERNI Rust Dev Container",
    "containerEnv": {
        // Keep the build tree off the bind mount: file sharing with the host is
        // slow, and the tree is wiped when the container is rebuilt.
        "CARGO_TARGET_DIR": "/tmp/cargo-target"
    },
    "build": {
        "dockerfile": "Dockerfile"
    },
    "runArgs": [
        // Files you create in the container belong to you on the host.
        "--userns=keep-id",
        // Lets the container reach services on the host's localhost.
        "--net=host"
    ],
    "customizations": {
        "vscode": {
            "settings": { // rust-analyzer checks the firmware target. The tests in crates/core and crates/face build
                // for your computer instead, so they are excluded here; run them with
                // scripts/test.sh, which also reports their compile errors.
                "rust-analyzer.cargo.allTargets": false,
                "rust-analyzer.check.allTargets": false,
                "rust-analyzer.cargo.target": "xtensa-esp32s3-none-elf"
            },
            // Editor settings live in .vscode/settings.json so they apply in
            // and outside the container.
            "extensions": [
                "rust-lang.rust-analyzer",
                "tamasfe.even-better-toml",
                "fill-labs.dependi",
                "vadimcn.vscode-lldb",
                "usernamehw.errorlens",
                "microhobby.taskrunnercodeplus",
                "DavidAnson.vscode-markdownlint",
                "MS-vsliveshare.vsliveshare",
                "GitHub.vscode-pull-request-github",
                "kdl-org.kdl"
            ]
        }
    },
    "postCreateCommand": "bash .devcontainer/post_create.sh"
}