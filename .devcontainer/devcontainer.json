{
    "name": "ERNI Rust Dev Container",
    "containerEnv": {
        // Keep the build tree off the bind mount: file sharing with the host is
        // slow, and the tree is wiped when the container is rebuilt.
        "CARGO_TARGET_DIR": "/tmp/cargo-target"
    },
    "build": {
        "dockerfile": "Dockerfile"
    },
    // No runArgs on purpose: this file is the same for Docker and for Podman.
    // Dev Containers passes Podman what it needs by itself (--userns=keep-id and
    // --security-opt label=disable) since devcontainers/cli 0.76.0. Writing
    // --userns=keep-id here instead would break Docker, which accepts only
    // --userns=host, and it clashes with --network=host under Podman
    // (devcontainers/cli#1301). See "Setup" in README.md.
    "containerUser": "vscode",
    "remoteUser": "vscode",
    // On Linux, give the container user your user id, so the files you create
    // belong to you on both sides of the bind mount.
    "updateRemoteUserUID": true,
    "customizations": {
        "vscode": {
            // Only what rust-analyzer needs to read this repository. It checks
            // the firmware target; the host tests of crates/core, crates/face
            // and crates/vision build for your computer instead, so they are
            // excluded here. Run them with scripts/test.sh, which also reports
            // their compile errors. Everything else is your own preference and
            // belongs in your user settings.
            "settings": {
                "rust-analyzer.cargo.allTargets": false,
                "rust-analyzer.check.allTargets": false,
                "rust-analyzer.cargo.target": "xtensa-esp32s3-none-elf"
            },
            "extensions": [
                "rust-lang.rust-analyzer",
                "tamasfe.even-better-toml",
                "fill-labs.dependi",
                "vadimcn.vscode-lldb",
                "usernamehw.errorlens",
                "microhobby.taskrunnercodeplus",
                "DavidAnson.vscode-markdownlint",
                "MS-vsliveshare.vsliveshare",
                "GitHub.vscode-pull-request-github",
                "kdl-org.kdl"
            ]
        }
    },
    "postCreateCommand": "bash .devcontainer/post_create.sh"
}
