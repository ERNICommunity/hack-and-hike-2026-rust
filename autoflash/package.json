{
  "name": "esp-autoflash",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:client && npm run build:worker",
    "build:client": "tsc --noEmit && vite build",
    "build:selfhost": "tsc --noEmit && vite build --config vite.selfhost.config.ts",
    "build:worker": "vite build --config vite.worker.config.ts",
    "preview": "vite preview",
    "serve": "cargo run --release",
    "test": "vitest run"
  },
  "dependencies": {
    "esptool-js": "0.6.1",
    "spark-md5": "3.0.2"
  },
  "devDependencies": {
    "@types/w3c-web-serial": "1.0.6",
    "typescript": "5.9.2",
    "vite": "7.1.3",
    "vitest": "3.2.4"
  }
}
