screen id="Speaker" width=276 height=240 theme="light" {
    grid cols="1fr 1fr" rows="20px 18px 36px 18px 34px 18px 34px 1fr" gap=4 padding=8 {
        label id="title_slot" text="" col=0 row=0 col_span=2
        label id="status_slot" text="" col=0 row=1 col_span=2
        label id="play_button_slot" text="" col=0 row=2
        label id="chime_button_slot" text="" col=1 row=2
        label id="tempo_value_slot" text="" col=0 row=3 col_span=2
        label id="tempo_slider_slot" text="" col=0 row=4 col_span=2
        label id="pitch_value_slot" text="" col=0 row=5 col_span=2
        label id="pitch_slider_slot" text="" col=0 row=6 col_span=2
        label id="hint_slot" text="" col=0 row=7 col_span=2
    }
}
