screen id="Settings" width=276 height=240 theme="light" {
    grid cols="1fr" rows="28px 18px 32px 18px 1fr" gap=8 padding=12 {
        label id="title" text="SETTINGS" col=0 row=0
        label id="brightness_label" text="DISPLAY BRIGHTNESS" col=0 row=1
        label id="brightness_slot" text="" col=0 row=2
        label id="brightness_hint" text="Drag to adjust the LCD backlight" col=0 row=3
    }
}
