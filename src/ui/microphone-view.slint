import { Theme } from "generated-theme.slint";

component WaveformPlot inherits Rectangle {
    in property <string> channel-name: "";

    background: Theme.black;
    border-color: Theme.dark-gray;
    border-width: 1px;
    clip: true;

    Text {
        x: 6px;
        y: 4px;
        text: root.channel-name;
        color: Theme.light-gray;
        font-size: 9px;
    }

    // Direct-render canvas. Rust's waveform.rs geometry must match this:
    // x = content(44) + layout padding(4) + 6 = 54
    // width = 256
    // y = plot top + 18
    //
    // Slint owns only the stable black canvas/chrome. Screen draws the grid
    // and realtime trace directly into these LCD pixels.
    Rectangle {
        x: 6px;
        y: 18px;
        width: 256px;
        height: 90px;
        background: Theme.white;
    }
}

export component MicrophoneView inherits Rectangle {
    background: Theme.white;
    clip: true;

    VerticalLayout {
        padding: 4px;
        spacing: 4px;

        WaveformPlot {
            height: 114px;
            channel-name: "MIC L";
        }

        WaveformPlot {
            height: 114px;
            channel-name: "MIC R";
        }
    }
}
