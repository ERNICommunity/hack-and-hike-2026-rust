import { ImuView } from "./imu-view.slint";
import { LogView } from "./log-view.slint";
import { NavigationRail } from "./navigation-rail.slint";
import { MicrophoneView } from "./microphone-view.slint";
import { PlaceholderView } from "./placeholder-view.slint";

export component AppWindow inherits Window {
    width: 320px;
    height: 240px;

    in property <string> log-text: "";
    in property <int> active-view: 4;
    in property <int> imu-roll-deg: 0;
    in property <int> imu-pitch-deg: 0;
    in property <int> imu-yaw-deg: 0;
    in property <int> imu-status: 0;
    in property <int> imu-read-errors: 0;
    in property <int> imu-mag-errors: 0;
    in property <int> imu-mag-status: 0;
    in property <int> imu-mag-field-ut: 0;
    in property <int> imu-mag-calibration: 0;
    in property <bool> imu-gyro-bias-ready: false;
    callback navigate(int);

    content := Rectangle {
        x: navigation.width;
        width: parent.width - navigation.width;
        height: parent.height;
        background: #ffffff;
        clip: true;

        PlaceholderView {
            width: parent.width;
            height: parent.height;
            visible: root.active-view == 0;
            title: "NETWORK";
            subtitle: "Peer communication";
        }

        ImuView {
            width: parent.width;
            height: parent.height;
            visible: root.active-view == 1;
            roll-deg: root.imu-roll-deg;
            pitch-deg: root.imu-pitch-deg;
            yaw-deg: root.imu-yaw-deg;
            status: root.imu-status;
            read-errors: root.imu-read-errors;
            mag-errors: root.imu-mag-errors;
            mag-status: root.imu-mag-status;
            mag-field-ut: root.imu-mag-field-ut;
            mag-calibration: root.imu-mag-calibration;
            gyro-bias-ready: root.imu-gyro-bias-ready;
        }

        MicrophoneView {
            width: parent.width;
            height: parent.height;
            visible: root.active-view == 2;
        }

        PlaceholderView {
            width: parent.width;
            height: parent.height;
            visible: root.active-view == 3;
            title: "SOUND";
            subtitle: "Speaker output";
        }

        LogView {
            width: parent.width;
            height: parent.height;
            visible: root.active-view == 4;
            log-text: root.log-text;
        }
    }

    navigation := NavigationRail {
        x: 0px;
        width: 44px;
        height: parent.height;
        active-view: root.active-view;

        view-selected(view) => {
            root.navigate(view);
        }
    }
}
