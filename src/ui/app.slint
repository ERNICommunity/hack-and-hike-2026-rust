import { Theme } from "./theme.slint";
import { LogView } from "./log-view.slint";
import { NavigationRail } from "./navigation-rail.slint";
import { MicrophoneView } from "./microphone-view.slint";

export component AppWindow inherits Window {
    width: 320px;
    height: 240px;

    in property <[string]> log-lines: [];
    in property <[float]> mic-left-samples: [];
    in property <[float]> mic-right-samples: [];

    // 0 = Network, 1 = IMU, 2 = Microphone, 3 = Sound, 4 = Log
    in-out property <int> active-view: 4;

    content := Rectangle {
        x: navigation.width;
        width: parent.width - navigation.width;
        height: parent.height;
        background: Theme.white;
        clip: true;

        // Keep the expensive repeated microphone item tree instantiated. Page
        // switches only toggle its visibility, avoiding heap churn on every
        // return to the realtime waveform.
        MicrophoneView {
            width: parent.width;
            height: parent.height;
            visible: root.active-view == 2;
            left-samples: root.mic-left-samples;
            right-samples: root.mic-right-samples;
        }

        // Log text items are much cheaper and remain lazy, so they don't occupy
        // renderer/item memory while realtime views are active.
        if root.active-view == 4: LogView {
            width: parent.width;
            height: parent.height;
            log-lines: root.log-lines;
        }
    }

    navigation := NavigationRail {
        x: 0px;
        width: 44px;
        height: parent.height;
        active-view: root.active-view;

        view-selected(view) => {
            root.active-view = view;
        }
    }
}
