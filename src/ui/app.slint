import { Theme } from "generated-theme.slint";
import { LogView } from "./log-view.slint";
import { NavigationRail } from "./navigation-rail.slint";
import { MicrophoneView } from "./microphone-view.slint";

export component AppWindow inherits Window {
    width: 320px;
    height: 240px;

    in property <[string]> log-lines: [];

    // 0 = Network, 1 = IMU, 2 = Microphone, 3 = Sound, 4 = Log
    in-out property <int> active-view: 4;

    content := Rectangle {
        x: navigation.width;
        width: parent.width - navigation.width;
        height: parent.height;
        background: Theme.white;
        clip: true;

        // Page shells stay allocated and are intentionally small. The realtime
        // microphone trace itself is drawn directly by Screen, outside Slint.
        MicrophoneView {
            width: parent.width;
            height: parent.height;
            visible: root.active-view == 2;
        }

        // ListView virtualizes the row delegates, so retaining this page does
        // not retain one visual item tree per log entry.
        LogView {
            width: parent.width;
            height: parent.height;
            visible: root.active-view == 4;
            log-lines: root.log-lines;
        }
    }

    navigation := NavigationRail {
        x: 0px;
        width: 44px;
        height: parent.height;
        active-view: root.active-view;

        view-selected(view) => {
            root.active-view = view;
        }
    }
}
