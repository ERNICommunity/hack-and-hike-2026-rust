import { VerticalBox } from "std-widgets.slint";

export component AppWindow inherits Window {
    width: 320px;
    height: 240px;
    background: #ffffff;

    in-out property <[string]> log-lines: [];

    VerticalBox {
        padding: 8px;
        spacing: 4px;

        Text {
            text: "M5Stack CoreS3";
            color: #58a6ff;
            font-size: 14px;
        }

        console_box := Rectangle {
            background: #161b22;
            border-radius: 4px;
            clip: true;
            
            flickable := Flickable {
                x: 6px;
                y: 6px;
                width: parent.width - 12px;
                height: parent.height - 12px;
                viewport-y: min(0px, flickable.height - flickable.viewport-height);
                
                animate viewport-y { duration: 350ms; easing: ease-out; }
                
                VerticalBox {
                    for line in root.log-lines: Text {
                        text: line;
                        color: #3fb950;
                        font-size: 11px;
                        wrap: word-wrap;
                        height: 14px;
                    }
                }
            }
        }
    }
}
