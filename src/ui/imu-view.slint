import { Theme } from "generated-theme.slint";

component HeaderValue inherits Rectangle {
    in property <string> label: "";
    in property <int> value-deg: 0;
    width: 58px;
    background: Theme.dark-blue;

    VerticalLayout {
        spacing: 0px;
        alignment: center;

        Text {
            text: root.label;
            color: Theme.light-gray;
            font-size: 7px;
            horizontal-alignment: center;
        }

        Text {
            text: "\{root.value-deg}°";
            color: Theme.white;
            font-size: 14px;
            horizontal-alignment: center;
        }
    }
}

export component ImuView inherits Rectangle {
    in property <int> roll-deg: 0;
    in property <int> pitch-deg: 0;
    in property <int> yaw-deg: 0;
    in property <int> status: 0;
    in property <int> read-errors: 0;
    in property <int> mag-errors: 0;
    in property <int> mag-status: 0;
    in property <int> mag-field-ut: 0;
    in property <int> mag-calibration: 0;
    in property <bool> gyro-bias-ready: false;

    // Slint's MCU software renderer does not implement rotation transforms.
    // The attitude indicator therefore builds a sloped artificial horizon from
    // nine fixed columns whose top edges move with roll and pitch. The item
    // count stays fixed and only inexpensive geometry properties animate.
    property <int> visual-roll: root.roll-deg < -45 ? -45 : root.roll-deg > 45 ? 45 : root.roll-deg;
    property <int> visual-pitch: root.pitch-deg < -40 ? -40 : root.pitch-deg > 40 ? 40 : root.pitch-deg;

    property <int> north-delta: -root.yaw-deg;
    property <int> east-delta: 90 - root.yaw-deg > 180 ? 90 - root.yaw-deg - 360 : 90 - root.yaw-deg;
    property <int> south-delta: 180 - root.yaw-deg > 180 ? 180 - root.yaw-deg - 360 : 180 - root.yaw-deg;
    property <int> west-delta: -90 - root.yaw-deg < -180 ? -90 - root.yaw-deg + 360 : -90 - root.yaw-deg;

    background: Theme.white;
    clip: true;

    header := Rectangle {
        x: 6px;
        y: 6px;
        width: parent.width - 12px;
        height: 44px;
        background: Theme.dark-blue;

        HorizontalLayout {
            padding-left: 6px;
            padding-right: 6px;
            padding-top: 3px;
            padding-bottom: 3px;
            spacing: 2px;

            VerticalLayout {
                width: 72px;
                spacing: 0px;
                alignment: center;

                Text {
                    text: "IMU 9-AXIS";
                    color: Theme.white;
                    font-size: 10px;
                }

                Text {
                    text: root.status == 3 ? "FAULT"
                        : root.status == 2 ? "DEGRADED"
                        : root.status == 1 ? "RUNNING"
                        : "STARTING";
                    color: Theme.light-gray;
                    font-size: 7px;
                }

                Text {
                    text: root.mag-status == 2 ? "MAG \{root.mag-field-ut} µT"
                        : root.mag-status == 1 ? "MAG CAL \{root.mag-calibration}%"
                        : root.mag-status == 3 ? "MAG DISTURBED"
                        : "MAG MISSING";
                    color: Theme.light-gray;
                    font-size: 6px;
                }
            }

            HeaderValue { label: "ROLL"; value-deg: root.roll-deg; }
            HeaderValue { label: "PITCH"; value-deg: root.pitch-deg; }
            HeaderValue { label: "YAW"; value-deg: root.yaw-deg; }
        }
    }

    attitude := Rectangle {
        x: 6px;
        y: 56px;
        width: parent.width - 12px;
        height: 140px;
        background: Theme.light-blue;
        border-color: Theme.light-gray;
        border-width: 1px;
        clip: true;

        // Segmented ground plane. Pitch translates the horizon vertically;
        // roll slopes it across the display without renderer transforms.
        ground0 := Rectangle {
            x: 0px; width: parent.width / 9 + 1px;
            y: parent.height / 2 + root.visual-pitch * 0.80px - root.visual-roll * 0.44px;
            height: parent.height - self.y; background: Theme.dark-gray;
            animate y, height { duration: 90ms; easing: ease-out; }
        }
        ground1 := Rectangle {
            x: parent.width / 9; width: parent.width / 9 + 1px;
            y: parent.height / 2 + root.visual-pitch * 0.80px - root.visual-roll * 0.33px;
            height: parent.height - self.y; background: Theme.dark-gray;
            animate y, height { duration: 90ms; easing: ease-out; }
        }
        ground2 := Rectangle {
            x: parent.width * 2 / 9; width: parent.width / 9 + 1px;
            y: parent.height / 2 + root.visual-pitch * 0.80px - root.visual-roll * 0.22px;
            height: parent.height - self.y; background: Theme.dark-gray;
            animate y, height { duration: 90ms; easing: ease-out; }
        }
        ground3 := Rectangle {
            x: parent.width * 3 / 9; width: parent.width / 9 + 1px;
            y: parent.height / 2 + root.visual-pitch * 0.80px - root.visual-roll * 0.11px;
            height: parent.height - self.y; background: Theme.dark-gray;
            animate y, height { duration: 90ms; easing: ease-out; }
        }
        ground4 := Rectangle {
            x: parent.width * 4 / 9; width: parent.width / 9 + 1px;
            y: parent.height / 2 + root.visual-pitch * 0.80px;
            height: parent.height - self.y; background: Theme.dark-gray;
            animate y, height { duration: 90ms; easing: ease-out; }
        }
        ground5 := Rectangle {
            x: parent.width * 5 / 9; width: parent.width / 9 + 1px;
            y: parent.height / 2 + root.visual-pitch * 0.80px + root.visual-roll * 0.11px;
            height: parent.height - self.y; background: Theme.dark-gray;
            animate y, height { duration: 90ms; easing: ease-out; }
        }
        ground6 := Rectangle {
            x: parent.width * 6 / 9; width: parent.width / 9 + 1px;
            y: parent.height / 2 + root.visual-pitch * 0.80px + root.visual-roll * 0.22px;
            height: parent.height - self.y; background: Theme.dark-gray;
            animate y, height { duration: 90ms; easing: ease-out; }
        }
        ground7 := Rectangle {
            x: parent.width * 7 / 9; width: parent.width / 9 + 1px;
            y: parent.height / 2 + root.visual-pitch * 0.80px + root.visual-roll * 0.33px;
            height: parent.height - self.y; background: Theme.dark-gray;
            animate y, height { duration: 90ms; easing: ease-out; }
        }
        ground8 := Rectangle {
            x: parent.width * 8 / 9; width: parent.width / 9 + 1px;
            y: parent.height / 2 + root.visual-pitch * 0.80px + root.visual-roll * 0.44px;
            height: parent.height - self.y; background: Theme.dark-gray;
            animate y, height { duration: 90ms; easing: ease-out; }
        }

        // Fixed aircraft reference and pitch ladder.
        Rectangle { x: parent.width / 2 - 36px; y: parent.height / 2; width: 26px; height: 2px; background: Theme.white; }
        Rectangle { x: parent.width / 2 + 10px; y: parent.height / 2; width: 26px; height: 2px; background: Theme.white; }
        Rectangle { x: parent.width / 2 - 1px; y: parent.height / 2 - 5px; width: 2px; height: 11px; background: Theme.white; }
        Rectangle { x: parent.width / 2 - 20px; y: parent.height / 2 - 23px; width: 40px; height: 1px; background: Theme.white; }
        Rectangle { x: parent.width / 2 - 12px; y: parent.height / 2 + 22px; width: 24px; height: 1px; background: Theme.white; }

        // Roll index moves across the top while the horizon supplies the main
        // roll cue. This remains visible even at large pitch angles.
        Rectangle {
            x: parent.width / 2 - 2px + root.visual-roll * 1.05px;
            y: 5px;
            width: 5px;
            height: 10px;
            background: Theme.white;
            animate x { duration: 90ms; easing: ease-out; }
        }

        Text {
            x: 5px;
            y: 4px;
            text: "PITCH / ROLL";
            color: Theme.white;
            font-size: 7px;
        }

        Text {
            x: 5px;
            y: parent.height - 13px;
            text: root.mag-status == 1 ? "Rotate through all axes • MAG CAL \{root.mag-calibration}%"
                : root.mag-status == 3 ? "Magnetic disturbance • yaw correction paused"
                : root.mag-status == 0 ? "BMM150 unavailable • gyro yaw fallback"
                : root.gyro-bias-ready ? "Magnetic heading • gyro bias ready"
                : "Magnetic heading • gyro bias learning";
            color: Theme.white;
            font-size: 7px;
        }

        Text {
            visible: root.read-errors > 0 || root.mag-errors > 0;
            x: parent.width - 88px;
            y: 4px;
            width: 82px;
            text: "I²C \{root.read-errors} • MAG \{root.mag-errors}";
            color: Theme.white;
            font-size: 6px;
            horizontal-alignment: right;
        }
    }

    compass := Rectangle {
        x: 6px;
        y: 202px;
        width: parent.width - 12px;
        height: 32px;
        background: Theme.white;
        border-color: Theme.light-gray;
        border-width: 1px;
        clip: true;

        Rectangle {
            x: 8px;
            y: 19px;
            width: parent.width - 16px;
            height: 1px;
            background: Theme.light-gray;
        }

        Text {
            x: parent.width / 2 + root.north-delta * 0.58px - 5px;
            y: 3px; width: 10px; text: "N"; color: Theme.dark-blue; font-size: 8px; horizontal-alignment: center;
            animate x { duration: 110ms; easing: ease-out; }
        }
        Text {
            x: parent.width / 2 + root.east-delta * 0.58px - 5px;
            y: 3px; width: 10px; text: "E"; color: Theme.dark-gray; font-size: 8px; horizontal-alignment: center;
            animate x { duration: 110ms; easing: ease-out; }
        }
        Text {
            x: parent.width / 2 + root.south-delta * 0.58px - 5px;
            y: 3px; width: 10px; text: "S"; color: Theme.dark-gray; font-size: 8px; horizontal-alignment: center;
            animate x { duration: 110ms; easing: ease-out; }
        }
        Text {
            x: parent.width / 2 + root.west-delta * 0.58px - 5px;
            y: 3px; width: 10px; text: "W"; color: Theme.dark-gray; font-size: 8px; horizontal-alignment: center;
            animate x { duration: 110ms; easing: ease-out; }
        }

        // Fixed lubber line: compass labels move beneath it as yaw changes.
        Rectangle {
            x: parent.width / 2 - 2px;
            y: 16px;
            width: 4px;
            height: 13px;
            background: Theme.dark-blue;
        }
    }
}
