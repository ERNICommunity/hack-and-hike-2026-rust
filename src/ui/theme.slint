export global Theme {
    in-out property <color> dark-blue: #033778;
    in-out property <color> light-blue: #00AADB;
    in-out property <color> dark-gray: #515455;
    in-out property <color> light-gray: #B1B0B1;
    in-out property <color> white: #ffffff;
    in-out property <color> black: #3C3C3B;
}
