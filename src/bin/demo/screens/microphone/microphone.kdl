screen id="Microphone" width=276 height=240 {
    grid cols="10px 256px 10px" rows="18px 101px 18px 101px 2px" gap=0 padding=0 {
        label id="left_label" text="MIC L" col=1 row=0 style="crate::styles::title()"
        label id="left_waveform" text="" col=1 row=1
        label id="right_label" text="MIC R" col=1 row=2 style="crate::styles::title()"
        label id="right_waveform" text="" col=1 row=3
    }
}
